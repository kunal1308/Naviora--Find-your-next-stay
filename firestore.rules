rules_version = '2';

// Naviora Firestore security rules.
// Paste into: Firebase console → Firestore Database → Rules → Publish.
// (Later we can deploy these with the Firebase CLI so they live in git.)

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in AND has clicked the email verification link.
    // (Google sign-ins are verified automatically.)
    function isVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    // Admin check by email. (A production app would use custom claims.)
    // The email must be verified, or anyone could claim the address.
    function isAdmin() {
      return isVerified()
        && request.auth.token.email == 'karan.arora040820@gmail.com';
    }

    // Rating fields come only from guest reviews (or the admin's seed tools).
    function touchesRating() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['rating', 'reviewCount', 'lastReviewId']);
    }

    // A guest's review may change ONLY the hotel's rating fields, and only in
    // the same write that creates their review (lastReviewId points at it).
    // The new average must match the old one plus this review's stars.
    function isReviewUpdate(hotelId) {
      let after = request.resource.data;
      let review = getAfter(/databases/$(database)/documents/reviews/$(after.lastReviewId)).data;
      let oldCount = resource.data.get('reviewCount', 0);
      let oldRating = resource.data.get('rating', 0);
      let expected = (float(oldRating) * float(oldCount) + float(review.rating))
        / float(oldCount + 1);
      return isVerified()
        && after.diff(resource.data).affectedKeys()
             .hasOnly(['rating', 'reviewCount', 'lastReviewId'])
        && after.reviewCount == oldCount + 1
        && !exists(/databases/$(database)/documents/reviews/$(after.lastReviewId))
        && review.hotelId == hotelId
        && review.userId == request.auth.uid
        && math.abs(float(after.rating) - expected) <= 0.051;
    }

    // A guest reviews a stay once it's over. The review id is the booking id
    // (one review per stay); the booking must be theirs, confirmed and past
    // check-out; and the hotel's rating must be updated in the same write.
    function isGuestReview(bookingId) {
      let review = request.resource.data;
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      let out = booking.checkOut.split('-');
      return isVerified()
        && review.keys().hasOnly(['hotelId', 'bookingId', 'userId', 'author',
                                  'rating', 'comment', 'createdAt'])
        && review.userId == request.auth.uid
        && review.bookingId == bookingId
        && review.rating is int && review.rating >= 1 && review.rating <= 5
        && review.comment is string
        && review.comment.size() > 0 && review.comment.size() <= 1000
        && review.author is string && review.author.size() <= 100
        && booking.userId == request.auth.uid
        && booking.hotelId == review.hotelId
        && booking.status == 'confirmed'
        && timestamp.date(int(out[0]), int(out[1]), int(out[2])) <= request.time
        && getAfter(/databases/$(database)/documents/hotels/$(review.hotelId))
             .data.lastReviewId == bookingId;
    }

    // Hotels — public read. Admin can write anything; a verified user can
    // create a listing they own (starting with no reviews) and manage only
    // their own listings, but never its rating. Guests update the rating only
    // through a review (isReviewUpdate).
    match /hotels/{doc} {
      allow read: if true;
      allow create: if isAdmin()
        || (isVerified()
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.rating == 0
            && request.resource.data.reviewCount == 0);
      allow update: if isAdmin()
        || (isVerified()
            && resource.data.ownerId == request.auth.uid
            && !touchesRating())
        || isReviewUpdate(doc);
      allow delete: if isAdmin()
        || (isVerified()
            && resource.data.ownerId == request.auth.uid);
    }

    match /destinations/{doc} { allow read: if true; allow write: if isAdmin(); }

    // Reviews — public read. The admin manages all of them (seed tools);
    // guests can only create their own review of a finished stay.
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if isGuestReview(reviewId);
    }

    // A user owns their profile doc (holds wishlist + avatarUrl).
    // The admin may read all user docs (for the admin Users page).
    // Writes stay open to unverified users: the profile is upserted on sign in.
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Bookings: a verified user can create and update only their own; any
    // signed-in owner can read theirs.
    // (Edit/cancel go through update; the "1 day before" rule is enforced in
    //  the app. Ownership can't be reassigned on update.)
    match /bookings/{id} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if isVerified() && request.auth.uid == request.resource.data.userId;
      allow update: if isVerified()
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    // Everything else denied by default.
    match /{document=**} { allow read, write: if false; }
  }
}
